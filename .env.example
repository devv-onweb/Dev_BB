# Database connection URL for PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/bloodbank_db?schema=public"

# Server configuration
PORT=5000
NODE_ENV=development

# JWT Secret for authentication
JWT_SECRET="supersecret_jwt_bloodbank_key_change_in_production"
JWT_EXPIRES_IN="7d"

# CORS Origin for frontend client
CORS_ORIGIN="http://localhost:5173"
