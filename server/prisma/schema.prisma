// Prisma Schema for Blood Bank Management System
// Database: SQLite via LibSQL Driver Adapter (100% pure JS/WASM cross-platform)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// MODELS
// --------------------------------------------------------

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          String   @default("PATIENT") // ADMIN | DONOR | PATIENT | HOSPITAL | USER
  phone         String?
  blood_group   String?  // A_POS | A_NEG | B_POS | B_NEG | AB_POS | AB_NEG | O_POS | O_NEG

  // Hospital Relation
  hospital_id   String?
  hospital      Hospital? @relation("HospitalUsers", fields: [hospital_id], references: [id], onDelete: SetNull)

  // Donor Deferral & Eligibility Fields
  deferral_status       String?   @default("ELIGIBLE") // ELIGIBLE | TEMPORARILY_INELIGIBLE | PERMANENTLY_DEFERRED | REQUIRES_MEDICAL_REVIEW
  deferral_reason       String?
  deferral_until        DateTime?
  medical_review_notes  String?

  // Donor Location & Privacy Fields
  latitude                 Float?
  longitude                Float?
  location_updated_at      DateTime?
  location_permission      Boolean?  @default(true)
  service_radius_km        Float?    @default(10.0)

  // Donor Reliability Score Fields
  reliability_score        Float?    @default(75.0)
  reliability_last_updated DateTime?
  total_requests_received  Int       @default(0)
  total_requests_accepted  Int       @default(0)
  total_completed_donations Int      @default(0)
  total_no_shows           Int       @default(0)
  total_cancellations      Int       @default(0)

  // Timestamps
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relationships
  donations       Donation[]      @relation("DonorDonations")
  blood_requests  BloodRequest[]  @relation("UserBloodRequests")
  profile         UserProfile?
  blood_orders    BloodOrder[]    @relation("UserBloodOrders")
  reports         Report[]        @relation("UserReports")
  doctor_messages DoctorMessage[] @relation("UserDoctorMessages")
  notifications   Notification[]  @relation("UserNotifications")

  @@map("users")
}

model UserProfile {
  id                  String    @id @default(uuid())
  user_id             String    @unique
  full_name           String
  dob                 DateTime?
  gender              String?
  weight_kg           Float?
  height_cm           Float?
  bmi                 Float?
  blood_group         String?
  city                String?
  address             String?
  emergency_contact   String?
  conditions          String?
  allergies           String?
  preferred_doctor_id String?

  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  user                User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  preferred_doctor    Doctor?   @relation("PreferredDoctorProfiles", fields: [preferred_doctor_id], references: [id], onDelete: SetNull)

  @@map("user_profiles")
}

model Hospital {
  id                String         @id @default(uuid())
  name              String         @unique
  address           String
  latitude          Float          @default(28.6139)
  longitude         Float          @default(77.2090)
  contact_number    String
  emergency_contact String
  is_verified       Boolean        @default(true)
  is_active         Boolean        @default(true)

  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  users             User[]         @relation("HospitalUsers")
  requests          BloodRequest[] @relation("HospitalRequests")
  blood_orders      BloodOrder[]   @relation("HospitalBloodOrders")
  doctors           Doctor[]       @relation("HospitalDoctors")

  @@map("hospitals")
}

model BloodInventory {
  id              String   @id @default(uuid())
  blood_group     String   @unique // A_POS, A_NEG, etc.
  units_available Int      @default(0)
  last_updated    DateTime @default(now()) @updatedAt

  @@map("blood_inventory")
}

model Donation {
  id            String   @id @default(uuid())
  donor_id      String
  units_donated Int      @default(1)
  donation_date DateTime @default(now())
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED

  // Timestamps
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relationships
  donor         User        @relation("DonorDonations", fields: [donor_id], references: [id], onDelete: Cascade)
  blood_units   BloodUnit[] @relation("DonationUnits")

  @@map("donations")
}

model BloodUnit {
  id               String    @id @default(uuid())
  unit_number      String    @unique
  blood_group      String    // A_POS | A_NEG | B_POS | B_NEG | AB_POS | AB_NEG | O_POS | O_NEG
  component_type   String    @default("RBC") // RBC | PLASMA | PLATELETS | WHOLE_BLOOD
  collection_date  DateTime  @default(now())
  expiry_date      DateTime
  volume_ml        Int       @default(450)
  donation_id      String?
  storage_location String    @default("Vault A - Main Cold Storage")
  status           String    @default("AVAILABLE") // AVAILABLE | RESERVED | EXPIRING_SOON | EXPIRED | USED | DISCARDED
  reserved_for_id  String?

  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  donation         Donation? @relation("DonationUnits", fields: [donation_id], references: [id], onDelete: SetNull)

  @@map("blood_units")
}

model BloodRequest {
  id              String   @id @default(uuid())
  requester_id    String
  blood_group     String   // A_POS, A_NEG, etc.
  units_requested Int
  hospital_name   String
  hospital_id     String?
  urgency         String   @default("STANDARD") // STANDARD | URGENT | STAT_CRITICAL
  status          String   @default("PENDING") // PENDING | APPROVED | FULFILLED | REJECTED

  // Timestamps
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relationships
  requester       User      @relation("UserBloodRequests", fields: [requester_id], references: [id], onDelete: Cascade)
  hospital        Hospital? @relation("HospitalRequests", fields: [hospital_id], references: [id], onDelete: SetNull)

  @@map("blood_requests")
}

model BloodOrder {
  id            String    @id @default(uuid())
  user_id       String
  blood_group   String
  units         Int
  hospital_name String
  hospital_id   String?
  urgency       String    @default("STANDARD") // STANDARD | URGENT | STAT_CRITICAL
  reason        String?
  needed_by     DateTime?
  status        String    @default("Pending") // Pending | Approved | Fulfilled | Rejected
  admin_notes   String?

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  user          User      @relation("UserBloodOrders", fields: [user_id], references: [id], onDelete: Cascade)
  hospital      Hospital? @relation("HospitalBloodOrders", fields: [hospital_id], references: [id], onDelete: SetNull)

  @@map("blood_orders")
}

model Report {
  id              String    @id @default(uuid())
  user_id         String
  file_name       String
  file_url        String?
  file_type       String?
  file_size       Int?
  extracted_text  String?
  summary         String?
  abnormal_values String?
  risk_flags      String?
  suggested_step  String?
  is_flagged      Boolean   @default(false)

  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user            User      @relation("UserReports", fields: [user_id], references: [id], onDelete: Cascade)

  @@map("reports")
}

model Doctor {
  id             String          @id @default(uuid())
  name           String
  specialty      String
  hospital_name  String
  hospital_id    String?
  phone          String
  email          String
  qualification  String?
  experience_yrs Int?            @default(5)
  avatar_url     String?
  is_available   Boolean         @default(true)

  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  hospital       Hospital?       @relation("HospitalDoctors", fields: [hospital_id], references: [id], onDelete: SetNull)
  messages       DoctorMessage[] @relation("DoctorMessages")
  preferred_by   UserProfile[]   @relation("PreferredDoctorProfiles")

  @@map("doctors")
}

model DoctorMessage {
  id         String    @id @default(uuid())
  user_id    String
  doctor_id  String
  sender     String    // "USER" | "DOCTOR"
  message    String
  read_at    DateTime?

  created_at DateTime  @default(now())

  user       User      @relation("UserDoctorMessages", fields: [user_id], references: [id], onDelete: Cascade)
  doctor     Doctor    @relation("DoctorMessages", fields: [doctor_id], references: [id], onDelete: Cascade)

  @@map("doctor_messages")
}

model Notification {
  id           String    @id @default(uuid())
  user_id      String
  type         String    // medicine_reminder | test_due | followup | order_status | health_tip
  title        String
  message      String
  scheduled_at DateTime  @default(now())
  read_at      DateTime?

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  user         User      @relation("UserNotifications", fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}
