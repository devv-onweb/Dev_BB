// Prisma Schema for Blood Bank Management System
// Database: SQLite via LibSQL Driver Adapter (100% pure JS/WASM cross-platform)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// MODELS
// --------------------------------------------------------

model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  password_hash String
  role          String  @default("PATIENT") // ADMIN | DONOR | PATIENT
  phone         String?
  blood_group   String? // A_POS | A_NEG | B_POS | B_NEG | AB_POS | AB_NEG | O_POS | O_NEG

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relationships
  donations      Donation[]     @relation("DonorDonations")
  blood_requests BloodRequest[] @relation("UserBloodRequests")

  @@map("users")
}

model BloodInventory {
  id              String   @id @default(uuid())
  blood_group     String   @unique // A_POS, A_NEG, etc.
  units_available Int      @default(0)
  last_updated    DateTime @default(now()) @updatedAt

  @@map("blood_inventory")
}

model Donation {
  id            String   @id @default(uuid())
  donor_id      String
  units_donated Int      @default(1)
  donation_date DateTime @default(now())
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relationships
  donor User @relation("DonorDonations", fields: [donor_id], references: [id], onDelete: Cascade)

  @@map("donations")
}

model BloodRequest {
  id              String @id @default(uuid())
  requester_id    String
  blood_group     String // A_POS, A_NEG, etc.
  units_requested Int
  hospital_name   String
  urgency         String @default("NORMAL") // NORMAL | URGENT
  status          String @default("PENDING") // PENDING | APPROVED | FULFILLED | REJECTED

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relationships
  requester User @relation("UserBloodRequests", fields: [requester_id], references: [id], onDelete: Cascade)

  @@map("blood_requests")
}
